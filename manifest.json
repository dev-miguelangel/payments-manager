{
  "manifest_version": 3,
  "name": "Pagos",
  "version": "1.0.0",
  "description": "Organiza tus pagos mensuales y únicos, y guarda sus comprobantes.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Pagos",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "storage",
    "sidePanel",
    "tabs",
    "scripting",
    "activeTab",
    "alarms",
    "downloads",
    "contextMenus",
    "notifications"
  ],
  "optional_host_permissions": [
    "<all_urls>"
  ],
  "commands": {
    "save-receipt": {
      "suggested_key": {
        "default": "Alt+Shift+P"
      },
      "description": "Guardar comprobante de la página"
    }
  }
}
